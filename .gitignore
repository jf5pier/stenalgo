__pycache__/
*.pyc
.local_history

# Regenerable caches (dictionary.py pipeline; util.build_phonetic_theory)
Dictionary.pickle
FeatureDiscrimator.pickle
PhoneticTheory.pickle
DisambiguatedTheory.pickle
AugTheory.pickle*

# Affix rule selection cache (util/build_affix_rules.py): per-rule evaluations; rm to force a full recompute
AffixSelection.pickle
AffixSelection.pickle.tmp

# Local pipeline step timings (util/_timing.py, appended per run)
pipeline_timings.log

# Regenerable report (src/ambiguitychecker.py __main__, hand-run diagnostic)
ambiguity_report.tsv

# Regenerable pipeline output (util.build_phonetic_theory / util.build_disambiguated_theory)
phonetic_theory.tsv
disambiguated_theory.tsv

# Regenerable Elicitation Phase outputs (src/elicitation.py, util/build_questionnaire_page.py)
questionnaire.json
elicitation_questionnaire.html
resolved_press_sets*.json

# Regenerable report (util/check_conjugation_disambiguation_order.py)
conjugation_disambiguation_report.json

env/

# External reference lexicon for cross-checking generated NOM/ADJ forms
# (util/crossCheckNomAdjWithMorphalou.py) -- large (>400MB of archives), not
# a project resource, never committed. Point --morphalou at wherever it's
# extracted locally.
morphalou/

# Raw Google Books French 1-gram shards (util/ngram_data.py download), ~5 GB
# compressed, never committed. Kept on disk until LexiqueGoogleNgram.tsv and
# LexiqueGoogleNgramAdditions.tsv are final and committed, then deleted by the
# manual `python -m util.ngram_data purge`.
googlebooks-fre-1grams/

# steno-trainer: compiled by `elm make` locally or in CI (deploy-steno-trainer.yml),
# never committed. public/data/*.json ARE committed -- see steno-trainer/README.md.
steno-trainer/main.js
steno-trainer/elm-stuff/
plover_stenalgo/plover_stenalgo/dictionaries/
