questionnaire.json
elicitation_questionnaire.html
resolved_press_sets*.json

# Regenerable report (util/check_conjugation_disambiguation_order.py)
conjugation_disambiguation_report.json

env/

# External reference lexicon for cross-checking generated NOM/ADJ forms
