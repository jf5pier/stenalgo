#!/usr/bin/env bash
# tagcheck: consistency of the tag registry, definitions and citations.
#   1. registry rows well-formed: PREFIX is 2-5 uppercase letters, unique,
#      three tab-separated columns, target file exists
#   2. every definition line's tag is registered and sits in the registered
#      file; no duplicate tag definitions
#   3. every tag of a registered prefix cited in docs/, CLAUDE.md, TODO.md or
#      the python sources has a definition line
# Unregistered prefixes are ignored by design (docs/TAGS.tsv header).
# Run after any edit to a tagged document or to docs/TAGS.tsv.
set -uo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$self_dir/taglib.sh"

root="$(tag_root)" || { echo "tagcheck: not inside the repository" >&2; exit 1; }
cd "$root"
if [ ! -f "$TAGS_FILE" ]; then
  echo "tagcheck: $TAGS_FILE missing (nothing to check)" >&2
  exit 1
fi

errors=0
fail() { printf 'tagcheck: %s\n' "$1" >&2; errors=$((errors + 1)); }

# --- 1. registry -------------------------------------------------------------
declare -A prefix_path=()
declare -A def_seen=()

while IFS= read -r line; do
  case "$line" in '#'*) continue ;; esac
  [ -z "$line" ] && continue
  cols="$(printf '%s' "$line" | awk -F'\t' '{ print NF }')"
  if [ "$cols" -ne 3 ]; then
    fail "$TAGS_FILE: row needs exactly 3 tab-separated columns: $line"
  fi
done < "$TAGS_FILE"

while IFS=$'\t' read -r prefix path description; do
  case "$prefix" in '#'*) continue ;; esac
  [ -z "$prefix" ] && continue
  if [[ ! "$prefix" =~ ^[A-Z]{2,5}$ ]]; then
    fail "$TAGS_FILE: bad prefix '$prefix' (2-5 uppercase letters)"
    continue
  fi
  if [ -n "${prefix_path[$prefix]+x}" ]; then
    fail "$TAGS_FILE: duplicate prefix $prefix"
    continue
  fi
  prefix_path[$prefix]="$path"
  [ -f "$path" ] || fail "$TAGS_FILE: $prefix points at missing file $path"
done < "$TAGS_FILE"

if [ "${#prefix_path[@]}" -eq 0 ]; then
  printf 'tagcheck: registry is empty — ok\n'
  exit 0
fi

# --- 2. definitions ----------------------------------------------------------
def_pattern='<!--[[:space:]]*tag:[[:space:]]*[A-Z]{2,5}[0-9]+[[:space:]]*\|'

mapfile -t scan_files < <(
  {
    printf '%s\n' "${prefix_path[@]}"
    find docs -type f 2>/dev/null
    [ -f CLAUDE.md ] && printf '%s\n' CLAUDE.md
    [ -f TODO.md ] && printf '%s\n' TODO.md
  } | sort -u
)

while IFS= read -r hit; do
  file="${hit%%:*}"
  rest="${hit#*:}"
  line_no="${rest%%:*}"
  tag="$(printf '%s' "$rest" | sed -E 's/.*tag:[[:space:]]*([A-Z]{2,5}[0-9]+).*/\1/')"
  prefix="${tag%%[0-9]*}"
  if [ -z "${prefix_path[$prefix]+x}" ]; then
    fail "$file:$line_no: definition of $tag but prefix $prefix is not registered"
    continue
  fi
  if [ "$file" != "${prefix_path[$prefix]}" ]; then
    fail "$file:$line_no: $tag defined here but $prefix is registered to ${prefix_path[$prefix]}"
  fi
  if [ -n "${def_seen[$tag]+x}" ]; then
    fail "$file:$line_no: duplicate definition of $tag (also ${def_seen[$tag]})"
  fi
  def_seen[$tag]="$file"
done < <(grep -RnE "$def_pattern" "${scan_files[@]}" 2>/dev/null)

# --- 3. citations ------------------------------------------------------------
prefix_alt="$(printf '%s\n' "${!prefix_path[@]}" \
  | awk '{ print length($0), $0 }' | sort -rn | cut -d' ' -f2- | paste -sd '|')"
cite_pattern='\b('"$prefix_alt"')[0-9]+'

declare -A cited=()
while IFS= read -r hit; do
  file="${hit%%:*}"
  tag="${hit##*:}"
  [ -n "${cited[$tag]+x}" ] || cited[$tag]="$file"
done < <(
  {
    grep -RoE "$cite_pattern" docs CLAUDE.md TODO.md 2>/dev/null
    grep -RoE --include='*.py' "$cite_pattern" src util dictionary.py lexique.py 2>/dev/null
  } | sort -u
)

for tag in "${!cited[@]}"; do
  if [ -z "${def_seen[$tag]+x}" ]; then
    fail "cited in ${cited[$tag]}: $tag has no definition line"
  fi
done

if [ "$errors" -eq 0 ]; then
  printf 'tagcheck: %d prefixes, %d tags defined, %d cited — ok\n' \
    "${#prefix_path[@]}" "${#def_seen[@]}" "${#cited[@]}"
  exit 0
fi
printf 'tagcheck: %d problem(s)\n' "$errors" >&2
exit 1
