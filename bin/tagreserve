#!/usr/bin/env bash
# tagreserve: register a tag prefix for a document in docs/TAGS.tsv.
# Usage: bin/tagreserve docs/FILE.md [PREFIX [DESCRIPTION]]
# Without PREFIX the prefix is derived from the file name's initials
# (mechanical rule, docs/TAGS.tsv header); with PREFIX the given one is
# validated. Nothing is written if the prefix is taken; the appended row is
# printed. Reserve before creating tagged items in a new document.
set -uo pipefail
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$self_dir/taglib.sh"

if [ $# -lt 1 ] || [ $# -gt 3 ]; then
  echo "usage: bin/tagreserve docs/FILE.md [PREFIX [DESCRIPTION]]" >&2
  exit 2
fi
root="$(tag_root)" || { echo "tagreserve: not inside the repository" >&2; exit 1; }
cd "$root"
doc="$1"
want="${2-}"
desc="${3-}"

if [[ "$doc" = /* || "$doc" =~ [[:space:][:cntrl:]] ]]; then
  echo "tagreserve: use a repo-relative path without whitespace, not: $doc" >&2
  exit 2
fi
[ -e "$doc" ] || echo "tagreserve: note: $doc does not exist yet" >&2
if [ -n "$desc" ] && [[ "$desc" =~ [[:cntrl:]] ]]; then
  echo "tagreserve: description must be a single printable line" >&2
  exit 2
fi

mkdir -p "$(dirname "$TAGS_FILE")"
[ -f "$TAGS_FILE" ] || tag_registry_header > "$TAGS_FILE"

prefix_taken() {
  awk -F'\t' -v p="$1" '!/^#/ && $1 == p { found = 1; exit } END { if (found) exit 0; exit 1 }' "$TAGS_FILE"
}

doc_registered() {
  awk -F'\t' -v d="$1" '!/^#/ && $2 == d { found = 1; exit } END { if (found) exit 0; exit 1 }' "$TAGS_FILE"
}

if doc_registered "$doc"; then
  echo "tagreserve: note: $doc already has registered prefix(es):" >&2
  awk -F'\t' -v d="$doc" '!/^#/ && $2 == d { print "  " $1 }' "$TAGS_FILE" >&2
fi

if [ -n "$want" ]; then
  if [[ ! "$want" =~ ^[A-Z]{2,5}$ ]]; then
    echo "tagreserve: PREFIX must be 2-5 uppercase letters, got: $want" >&2
    exit 2
  fi
  prefix="$want"
else
  # Mechanical rule: initials of the file name's words (first three), padded
  # from the first word when shorter than two letters; then extensions with
  # the fourth word's initial and with further letters of the last word used.
  stem="$(basename "$doc")"
  stem="${stem%.*}"
  words=()
  while IFS= read -r w; do
    [ -n "$w" ] && words+=("$(printf '%s' "$w" | tr '[:lower:]' '[:upper:]')")
  done < <(printf '%s\n' "$stem" | tr '. _-' '\n' | sed '/^$/d')
  if [ "${#words[@]}" -eq 0 ]; then
    echo "tagreserve: cannot derive a prefix from $doc; pass one explicitly" >&2
    exit 1
  fi
  base=""
  n=${#words[@]}
  for ((i = 0; i < n && i < 3; i++)); do base+="${words[i]:0:1}"; done
  i=1
  while [ ${#base} -lt 2 ] && [ "$i" -lt "${#words[0]}" ]; do
    base+="${words[0]:$i:1}"
    i=$((i + 1))
  done
  cands=("$base")
  if [ "$n" -gt 3 ]; then cands+=("${base}${words[3]:0:1}"); fi
  last=$((n < 3 ? n - 1 : 2))
  w="${words[last]}"
  for ((i = 1; i < ${#w} && ${#base} + 1 <= 5; i++)); do
    cands+=("${base}${w:$i:1}")
  done
  prefix=""
  for c in "${cands[@]}"; do
    if [[ "$c" =~ ^[A-Z]{2,5}$ ]] && ! prefix_taken "$c"; then
      prefix="$c"
      break
    fi
  done
  if [ -z "$prefix" ]; then
    echo "tagreserve: every prefix derived from $doc is taken; pass one explicitly" >&2
    exit 1
  fi
fi

if prefix_taken "$prefix"; then
  registered="$(awk -F'\t' -v p="$prefix" '!/^#/ && $1 == p { print $1 " -> " $2; exit }' "$TAGS_FILE")"
  echo "tagreserve: prefix already registered ($registered); nothing written" >&2
  exit 1
fi

printf '%s\t%s\t%s\n' "$prefix" "$doc" "$desc" >> "$TAGS_FILE"
echo "reserved: $prefix -> $doc (appended to $TAGS_FILE)"
